# 复制成 backend/.env 后填写；.env 不会被提交。

# 文本模型（分镜生成）。DeepSeek / 通义 / Kimi / 智谱 / OpenAI 都是 OpenAI 兼容接口。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉模型（视频/图片反推分镜）。留空则复用上面的 Key 与地址。
# 若文本与看图用不同厂商，单独填这两项，例如通义千问 VL：
# VISION_API_KEY=
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# 可选调参
LLM_TIMEOUT=90
MAX_UPLOAD_MB=50
MAX_FRAMES=6

# --- 认证与持久化 ---
# 数据库：SQLite 单文件；相对路径相对 backend/ 目录
APP_DB_URL=sqlite:///./recut.db
# 会话 cookie 名与有效期
APP_SESSION_COOKIE=recut_session
APP_SESSION_TTL_HOURS=12
APP_SESSION_REMEMBER_DAYS=30
APP_SESSION_SLIDING=true
# 生产环境走 HTTPS 时必须改成 true
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=lax
# 连续失败几次锁定、锁定多少分钟（锁定按邮箱维度）
APP_MAX_LOGIN_ATTEMPTS=5
APP_LOCKOUT_MINUTES=15
APP_PASSWORD_MIN_LENGTH=10
# 允许携带 cookie 的前端来源，逗号分隔
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 参考首帧的落盘目录（默认 backend/uploads）
APP_UPLOAD_DIR=

# --- 部署（容器 / 创空间）---
# 部署环境没有终端，用这两个变量在首次启动时创建管理员；
# 仅在库中一个用户都没有时生效，本地不填即可。
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=管理员
